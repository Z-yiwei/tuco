PY=python
TRAK_PY=python
PREP_ROOT=/path/to/outputs/single_sim/square_mh/preparation
OUTPUT_ROOT=/path/to/outputs/single_sim/square_mh/filter
TASK_MH=square_mh
SPLIT=filter
SEED=0
DEVICE=cuda:0

# Filtering: set FILTER_RATIO. Selection: set SPLIT=select and SELECT_RATIO.
FILTER_RATIO=0.25
# SELECT_RATIO=0.25

# Optional overrides:
# DATA_ROOT=/path/to/already_prepared_inputs
# PAIRWISE=/path/to/pairwise.npy
# TARGET_ENDS=/path/to/target_ends.npy
# CANDIDATE_ENDS=/path/to/candidate_ends.npy
# RETURNS=/path/to/returns.npy
# CANDIDATE_IDS=/path/to/candidate_ids.npy
# PAIRWISE_LAYOUT=candidate_by_target
# RUN_DIR=/path/to/policy_output
