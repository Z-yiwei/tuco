PY=python
TASK=peg
TARGET_ZARR=/path/to/mujoco_target.zarr
SOURCE_ZARR=/path/to/isaacsim_source.zarr
ROLLOUT_ZARR=/path/to/mujoco_rollouts.zarr
OUTPUT_ROOT=/path/to/outputs/sim2sim/peg/seed42
BUDGET=1500
SEED=42
DEVICE=cuda:0

# Optional execution overrides. Formal defaults come from configs/sim2sim/$TASK.toml.
# STEPS=1
# CHECKPOINT_EVERY=1
# KEEP_LAST=1
# NUM_WORKERS=0

# Formal MuJoCo evaluation input for the selected task:
# PEG_RESET_PT=/path/to/peg_eval_resets.pt
# STACKCUBE_RUNTIME_ZARR=/path/to/stackcube_eval_runtime.zarr
# CUPCAKE_RUNTIME_ZARR=/path/to/cupcake_runtime.zarr
# CUPCAKE_RESET_POOL_NPZ=/path/to/cupcake_eval_resets.npz
# EVAL_DEVICE=cuda:0
# EVAL_WORKERS=4
# EVAL_EPISODE_START=0
