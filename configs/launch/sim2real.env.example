PY=python
TASK=peg
METHOD=tuco
CHECKPOINT=/path/to/frozen_policy.ckpt
REAL_ROOT=/path/to/real_rollouts
GPUS="0 1 2 3"
GPU=0
SEED=42
DATA_ROOT=${ROOT}/data/sim2real/${TASK}
SOURCE_HDF5=${DATA_ROOT}/prepared/${TASK}_sim6000/image.hdf5
SOURCE_CACHE=${DATA_ROOT}/prepared/${TASK}_sim6000/replay_cache.zarr.zip
SOURCE_ZARR=${DATA_ROOT}/collection/states.zarr
OUTPUT_ROOT=${ROOT}/runs/sim2real/${TASK}/seed${SEED}/${METHOD}
RUN_DIR=${OUTPUT_ROOT}/policy
TRAIN_CACHE=${OUTPUT_ROOT}/train_cache.zarr.zip
DATASET_NAME=${TASK}_${METHOD}_seed${SEED}

# StackCube training additionally requires:
VARIANTS_ROOT=${ROOT}/data/sim2real/stackcube/seed${SEED}/${METHOD}/variants
MATERIALIZED_HDF5=${ROOT}/data/sim2real/stackcube/seed${SEED}/${METHOD}/selected/image.hdf5
# Extra visual variants are generated before training; set 0 to reuse existing ones.
# GENERATE_VARIANTS=1
# ARTIFACT_ROOT=/path/to/scene_assets_and_experts
# PY_ISAAC=/path/to/omnireset_isaac/bin/python

# CupCake training additionally requires:
# BASE_CONFIG=/path/to/cupcake_resolved.yaml
