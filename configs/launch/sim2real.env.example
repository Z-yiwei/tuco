PY=/path/to/omnireset_release/bin/python
TASK=peg
CHECKPOINT=/path/to/frozen_policy.ckpt
SOURCE_HDF5=/path/to/source/image.hdf5
SOURCE_CACHE=/path/to/source/cache.zarr.zip
SOURCE_ZARR=/path/to/source/states.zarr
REAL_ROOT=/path/to/real_rollouts
OUTPUT_ROOT=/path/to/outputs/sim2real/peg/tuco
RUN_DIR=/path/to/outputs/sim2real/peg/policy
TRAIN_CACHE=/path/to/outputs/sim2real/peg/train_cache.zarr.zip
DATASET_NAME=peg_tuco
GPUS="0 1 2 3"
GPU=0
SEED=42

# Comparison methods additionally set METHOD, FEATURE_NPZ, and BUDGET, then
# use experiments/sim2real/run_baseline.sh with this same launch file.
# METHOD=datamil
# FEATURE_NPZ=/path/to/prepared_diffusion_features.npz
# BUDGET=600

# StackCube training additionally requires:
# VARIANTS_ROOT=/path/to/stackcube_variants
# MATERIALIZED_HDF5=/path/to/stackcube_tuco/image.hdf5

# CupCake training additionally requires:
# BASE_CONFIG=/path/to/cupcake_resolved.yaml
