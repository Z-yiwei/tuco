# All project code is shipped in runtime/; only the IsaacSim SDK is external.
PY_ISAAC=${PY_ISAAC:-$(conda run -n omnireset_isaac python -c 'import sys; print(sys.executable)')}
PY_MUJOCO=${PY_MUJOCO:-python}
TUCO_ROOT=${TUCO_ROOT:?Launch through scripts/generate_data.sh}
ARTIFACT_ROOT=${ARTIFACT_ROOT:-${TUCO_ROOT}/artifacts}
OMNIRESET_ROOT=${TUCO_ROOT}/runtime/omnireset
DATA_ROOT=${DATA_ROOT:-${TUCO_ROOT}/data}
WORK_ROOT=${WORK_ROOT:-${TUCO_ROOT}/runs/data_generation}
SIM2REAL_DATA_ROOT=${SIM2REAL_DATA_ROOT:-${DATA_ROOT}/sim2real}
GPU=${GPU:-0}
GPUS=${GPUS:-0}
SEED=${SEED:-42}
PEG_TEACHER=${PEG_TEACHER:-${ARTIFACT_ROOT}/experts/sim2sim/peg/model_4550.pt}
STACKCUBE_TEACHER=${STACKCUBE_TEACHER:-${ARTIFACT_ROOT}/experts/sim2sim/stackcube/model_31000.pt}
CUPCAKE_TEACHER=${CUPCAKE_TEACHER:-${ARTIFACT_ROOT}/experts/sim2sim/cupcake/model_20400.pt}
# Real rollouts: Peg/StackCube accept rollout_sync.h5 or exported demo_*/trajectory.npz.
# CupCake exports recorded training_capture/plans and observations into REAL_ROOT.
# REAL_RAW_ROOT=/path/to/cupcake_recordings
# REAL_ROOT=/path/to/real_decisions
PEG_RESET_PT=${PEG_RESET_PT:-${ARTIFACT_ROOT}/datasets/OmniReset/Resets/Peg__PegHole/resets_ObjectAnywhereEEAnywhere_upright_yaw_3cm.pt}
STACKCUBE_RESET_PT=${STACKCUBE_RESET_PT:-${ARTIFACT_ROOT}/datasets/OmniReset/Resets/InsertiveCube__ReceptiveCube/resets_ObjectAnywhereEEAnywhere.pt}
DRY_RUN=${DRY_RUN:-0}
